# Public URL of the live site (metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry emails (Gmail). Use an App Password, not your normal password.
GMAIL_USER=yourshopgmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where enquiries are delivered. Defaults to the business email in src/data/business.ts.
ENQUIRY_TO=Surprisemax123@gmail.com

# Optional: another SMTP provider instead of Gmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable analytics and the consent banner.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (the content value only). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to true on hosts other than Vercel to add the upgrade-insecure-requests header.
ENFORCE_HTTPS=false
